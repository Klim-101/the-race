{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "resolveJsonModule": true,
    "paths": {
      "@the-race/engine": ["../engine/src/index.ts"],
      "@the-race/news": ["../news/src/index.ts"],
      "@the-race/saves": ["../saves/src/index.ts"]
    }
  },
  "include": [
    "src",
    "src/locales/*.json",
