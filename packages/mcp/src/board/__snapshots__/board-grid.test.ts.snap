// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a suspect card > matches its snapshot 1`] = `
"
<h2>The cast</h2>
<div class="card suspect" data-pick="suspect:a" data-rel="suspect:a place:market clue:flour" tabindex="0" role="button">
<div class="who"><svg class="portrait p1" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27"/><circle class="head" cx="28" cy="21" r="9"/><path class="body" d="M10 52c1-12 8-18 18-18s17 6 18 18z"/><text x="28" y="25" text-anchor="middle">A</text></svg><div><strong>Anna</strong>
<p>Someone</p>
<p class="tag">Last seen: right here</p>
<p><span class="gauge mood-cornered" role="img" aria-label="cornered"><span class="step on"></span><span class="step on"></span><span class="step on"></span><span class="step"></span></span> <span class="tag">Mood: cornered</span></p></div></div>
<p class="warn">will not talk until day 3, 02:05</p>
<details><summary>What they said (2)</summary>
<div class="day"><span class="tag">day 1</span>
<p class="statement"><span class="tag">alibi</span><br>I never left the oven.</p></div>
<div class="day"><span class="tag">day 2</span>
<p class="statement fell"><span class="tag">gave ground · a lie that fell</span><br><s>I left at nine.</s><br><span class="tag">broken by:</span> <span class="chip fx-breaks-lie" data-pick="clue:flour" data-rel="clue:flour place:market suspect:a suspect:b" tabindex="0" role="button"><span class="num">MIRA-02</span> </span></p></div></details>
<h3>Shown to them</h3>
<p class="chips"><span class="chip fx-breaks-lie" data-pick="clue:flour" data-rel="clue:flour place:market suspect:a suspect:b" tabindex="0" role="button"><span class="num">MIRA-02</span> broke a lie · turn 6</span></p>
</div>
<div class="card suspect" data-pick="suspect:b" data-rel="suspect:b clue:key clue:flour" tabindex="0" role="button">
<div class="who"><svg class="portrait p2" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27"/><circle class="head" cx="28" cy="21" r="9"/><path class="body" d="M10 52c1-12 8-18 18-18s17 6 18 18z"/><text x="28" y="25" text-anchor="middle">B</text></svg><div><strong>Boris</strong>
<p>Someone</p>
<p class="tag">Last seen: anywhere, apparently</p>
<p><span class="gauge mood-broken" role="img" aria-label="broken"><span class="step on"></span><span class="step on"></span><span class="step on"></span><span class="step on"></span></span> <span class="tag">Mood: broken</span></p></div></div>
<h3>What they said</h3>
<p class="empty">Nothing said yet.</p>
<h3>Shown to them</h3>
<p class="chips"><span class="chip fx-implicates" data-pick="clue:key" data-rel="clue:key place:stall suspect:b" tabindex="0" role="button"><span class="num">MIRA-01</span> bore on them · turn 7</span> <span class="chip fx-confirms" data-pick="clue:flour" data-rel="clue:flour place:market suspect:a suspect:b" tabindex="0" role="button"><span class="num">MIRA-02</span> confirmed a fallen lie · turn 8</span></p>
</div>
<div class="card suspect" data-pick="suspect:c" data-rel="suspect:c" tabindex="0" role="button">
<div class="who"><svg class="portrait p3" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27"/><circle class="head" cx="28" cy="21" r="9"/><path class="body" d="M10 52c1-12 8-18 18-18s17 6 18 18z"/><text x="28" y="25" text-anchor="middle">C</text></svg><div><strong>Cora</strong>
<p>Someone</p>
<p class="tag">Last seen: anywhere, apparently</p>
<p><span class="gauge mood-calm" role="img" aria-label="calm"><span class="step on"></span><span class="step"></span><span class="step"></span><span class="step"></span></span> <span class="tag">Mood: calm</span></p></div></div>
<h3>What they said</h3>
<p class="empty">Nothing said yet.</p>
<h3>Shown to them</h3>
<p class="empty">Nothing shown yet.</p>
</div>
"
`;

exports[`the clue grid > matches its snapshot 1`] = `
"
<h2>Who was shown what</h2>
<div class="legend"><span><b class="cell c-breaks">✕</b>broke a lie</span><span><b class="cell c-conf">✓</b>confirmed a fallen lie</span><span><b class="cell c-impl">!</b>bore on them</span><span><b class="cell c-none">·</b>no effect</span><span><b class="cell c-todo">?</b>bears on them, not shown</span></div>
<div class="wrapx"><table class="matrix">
<thead><tr class="place"><th class="who"></th><th colspan="1" scope="colgroup">Stall</th><th colspan="2" scope="colgroup">Market</th></tr><tr><th class="who"></th><th scope="col" class="clue" data-pick="clue:key" data-rel="clue:key place:stall suspect:b" tabindex="0" role="button"><span class="num">MIRA-01</span></th><th scope="col" class="clue" data-pick="clue:flour" data-rel="clue:flour place:market suspect:a suspect:b" tabindex="0" role="button"><span class="num">MIRA-02</span></th><th scope="col" class="clue" data-pick="clue:glove" data-rel="clue:glove place:market" tabindex="0" role="button"><span class="num">MIRA-03</span></th></tr></thead>
<tbody>
<tr><th scope="row" class="who" data-pick="suspect:a" data-rel="suspect:a place:market clue:flour" tabindex="0" role="button">Anna<small>Last seen: right here</small></th><td></td><td><span class="cell c-breaks" role="img" aria-label="broke a lie" title="broke a lie">✕</span></td><td></td></tr>
<tr><th scope="row" class="who" data-pick="suspect:b" data-rel="suspect:b clue:key clue:flour" tabindex="0" role="button">Boris<small>Last seen: anywhere, apparently</small></th><td><span class="cell c-impl" role="img" aria-label="bore on them" title="bore on them">!</span></td><td><span class="cell c-conf" role="img" aria-label="confirmed a fallen lie" title="confirmed a fallen lie">✓</span></td><td></td></tr>
<tr><th scope="row" class="who" data-pick="suspect:c" data-rel="suspect:c" tabindex="0" role="button">Cora<small>Last seen: anywhere, apparently</small></th><td></td><td></td><td></td></tr>
<tr class="foot"><th scope="row" class="who">In links</th><td class="used">1</td><td class="used">1</td><td class="unused" title="none">—</td></tr>
</tbody></table></div>
<p class="note">A dashed question mark: the clue bears on the person and you have not shown it to them. A dash at the bottom: the clue is in no link yet. Pick a number or a name to light everything tied to it.</p>
<h2>Card index (3)</h2>
<div class="filters" role="search" aria-label="Filter the clues">
<label>Found at <select id="f-place"><option value="">any</option><option value="stall">Stall</option><option value="market">Market</option></select></label>
<label>Shown to <select id="f-suspect"><option value="">any</option><option value="a">Anna</option><option value="b">Boris</option></select></label>
<label><input type="checkbox" id="f-garbled"> to be read again</label>
<label><input type="checkbox" id="f-unused"> not yet used in a link</label>
<label>Number <input type="search" id="f-number" placeholder="such as MIRA-01" size="12"></label>
</div>
<div class="grid"><div class="card clue-card" id="card-key" data-pick="clue:key" data-rel="clue:key place:stall suspect:b" data-place="stall" data-shown="b" data-garbled="1" data-unused="0" data-number="MIRA-01" tabindex="0" role="button">
<span class="tag"><span class="num">MIRA-01</span> · found at Stall · turn 2</span>
<p class="text">Text of key.</p>
<p class="warn">read badly: read it again before it counts</p>
</div>
<div class="card clue-card" id="card-flour" data-pick="clue:flour" data-rel="clue:flour place:market suspect:a suspect:b" data-place="market" data-shown="a b" data-garbled="0" data-unused="0" data-number="MIRA-02" tabindex="0" role="button">
<span class="tag"><span class="num">MIRA-02</span> · found at Market · turn 3</span>
<p class="text">Text of flour.</p>
</div>
<div class="card clue-card" id="card-glove" data-pick="clue:glove" data-rel="clue:glove place:market" data-place="market" data-shown="" data-garbled="0" data-unused="1" data-number="MIRA-03" tabindex="0" role="button">
<span class="tag"><span class="num">MIRA-03</span> · found at Market · turn 4</span>
<p class="text">Text of glove.</p>
<p class="marks"><span class="mk">shown to nobody</span> <span class="mk">in no link</span></p>
</div></div>
<p class="empty" id="clue-none" hidden>No clue fits.</p>
"
`;

exports[`the conclusions tab > matches its snapshot 1`] = `
"
<h2>Links tried</h2>
<div class="cols"><span>Clues</span><span>Link</span><span>Conclusion</span><span>Lead</span></div>
<div class="tree"><div class="branch" data-rel="clue:key clue:flour">
<div class="srcs"><div class="src" data-pick="clue:key" data-rel="clue:key place:stall suspect:b lead:l1 lead:l2 lead:l3 lead:l4 lead:l5" tabindex="0" role="button"><span class="num">MIRA-01</span><span class="t">Text of key.</span></div><div class="src" data-pick="clue:flour" data-rel="clue:flour place:market suspect:a suspect:b lead:l1 lead:l2 lead:l3 lead:l4" tabindex="0" role="button"><span class="num">MIRA-02</span><span class="t">Text of flour.</span></div></div><div class="arrow" aria-hidden="true">▶</div><div class="linkbox"><b>Link 1 · turn 9</b>a conclusion</div><div class="arrow" aria-hidden="true">▶</div>
<div class="insight">The flour was moved.</div><div class="arrow" aria-hidden="true">▶</div>
<div class="leads"><div class="lead " data-pick="lead:l1" data-rel="lead:l1" tabindex="0" role="button"><b>LEAD</b>Reason of l1.<br><span class="tag">can be followed now</span></div><div class="lead done" data-pick="lead:l2" data-rel="lead:l2" tabindex="0" role="button"><b>LEAD</b>Reason of l2.<br><span class="tag">followed to the end</span></div><div class="lead shut" data-pick="lead:l3" data-rel="lead:l3" tabindex="0" role="button"><b>LEAD</b>Reason of l3.<br><span class="tag">shut at this hour</span></div><div class="lead idle" data-pick="lead:l4" data-rel="lead:l4" tabindex="0" role="button"><b>LEAD</b>Reason of l4.<br><span class="tag">has opened nothing yet</span></div></div>
</div>
<div class="branch cold" data-rel="clue:glove clue:flour">
<div class="srcs"><div class="src" data-pick="clue:glove" data-rel="clue:glove place:market" tabindex="0" role="button"><span class="num">MIRA-03</span><span class="t">Text of glove.</span></div><div class="src" data-pick="clue:flour" data-rel="clue:flour place:market suspect:a suspect:b lead:l1 lead:l2 lead:l3 lead:l4" tabindex="0" role="button"><span class="num">MIRA-02</span><span class="t">Text of flour.</span></div></div><div class="arrow" aria-hidden="true">▶</div><div class="linkbox"><b>Link 2 · turn 10</b>led nowhere</div><div class="arrow" aria-hidden="true">▶</div>
<div class="insight">—</div><div class="arrow" aria-hidden="true"></div>
<div class="leads"></div>
</div>
<div class="branch" data-rel="clue:key clue:glove">
<div class="srcs"><div class="src" data-pick="clue:key" data-rel="clue:key place:stall suspect:b lead:l1 lead:l2 lead:l3 lead:l4 lead:l5" tabindex="0" role="button"><span class="num">MIRA-01</span><span class="t">Text of key.</span></div><div class="src" data-pick="clue:glove" data-rel="clue:glove place:market" tabindex="0" role="button"><span class="num">MIRA-03</span><span class="t">Text of glove.</span></div></div><div class="arrow" aria-hidden="true">▶</div><div class="linkbox"><b>Link 3 · turn 11</b>already known</div><div class="arrow" aria-hidden="true">▶</div>
<div class="insight">—</div><div class="arrow" aria-hidden="true"></div>
<div class="leads"></div>
</div>
<div class="branch" data-rel="clue:glove">
<div class="srcs"><div class="src" data-pick="clue:glove" data-rel="clue:glove place:market" tabindex="0" role="button"><span class="num">MIRA-03</span><span class="t">Text of glove.</span></div></div><div class="arrow" aria-hidden="true">▶</div><div></div><div class="arrow" aria-hidden="true">▶</div>
<div class="insight">The glove was left on purpose.</div><div class="arrow" aria-hidden="true"></div>
<div class="leads"></div>
</div></div>
<h2>Not yet linked</h2>
<div class="open-slots" aria-label="Links still to be made"><span class="open-slot"><i></i><i></i> 2 × a link of 2</span><span class="open-slot"><i></i><i></i><i></i> 1 × a link of 3</span></div>
<p class="note">The empty cells only count the links left and how many clues each takes. Which ones is yours to find out.</p>
"
`;

