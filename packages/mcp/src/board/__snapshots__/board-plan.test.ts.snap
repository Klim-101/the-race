// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the plan of a building > matches its snapshot 1`] = `
"<div class="plan" id="open-plan-hall" role="dialog" aria-label="Plan of Room hall" tabindex="-1">
<p class="tag">Plan of Room hall · Opens onto: Elm Street</p>
<div class="graph paper-map"><svg class="plan-svg" viewBox="0 0 928 288" role="img" aria-label="Plan of Room hall" style="min-width:520px"><g class="doors"><g class="door-way"><title>door between Room hall and Room vault</title><line x1="266" y1="144" x2="338" y2="40"/><rect x="297" y="84" width="10" height="16" rx="2"/></g><g class="door-way"><title>door between Room vault and Room loft</title><line x1="590" y1="40" x2="662" y2="40"/><rect x="621" y="32" width="10" height="16" rx="2"/></g></g><g class="room visited current" data-rel="place:hall clue:key clue:flour"><title>Room hall</title><rect class="walls" x="14" y="14" width="252" height="260" rx="4"/><text class="room-name" x="28" y="36">Room hall</text><circle class="here-dot" cx="250" cy="30" r="5"/><g class="part searched"><title>The oak desk: searched · gave</title><g class="mark done" transform="translate(34 62)"><circle r="9"/><path d="M-4 0l3 3l5 -6"/></g><text class="part-name" x="52" y="60">The oak desk</text><text class="part-state" x="52" y="77">searched · gave</text><g class="clue-chip" data-pick="clue:key" data-rel="clue:key place:hall" tabindex="0" role="button"><text x="164" y="77">MIRA-01</text></g><g class="clue-chip" data-pick="clue:flour" data-rel="clue:flour place:hall" tabindex="0" role="button"><text x="234" y="77">MIRA-02</text></g></g><g class="part locked"><title>A locked drawer: locked · tool in the kit: lock picks</title><g class="mark shut" transform="translate(34 98)"><circle r="9"/><g class="sign locked" transform="translate(0 1)"><rect x="-6" y="-2" width="12" height="9" rx="1.5"/><path d="M-4 -2v-3a4 4 0 0 1 8 0v3"/></g></g><text class="part-name" x="52" y="96">A locked drawer</text><text class="part-state" x="52" y="113">locked · tool in the kit: lock picks</text></g><g class="part dark"><title>The dark corner: dark · no tool for it in the kit</title><g class="mark shut" transform="translate(34 134)"><circle r="9"/><text y="4" text-anchor="middle">◐</text></g><text class="part-name" x="52" y="132">The dark corner</text><text class="part-state" x="52" y="149">dark · no tool for it in the kit</text></g><g class="part searched"><title>The empty shelf: searched · found nothing</title><g class="mark done" transform="translate(34 170)"><circle r="9"/><path d="M-4 0l3 3l5 -6"/></g><text class="part-name" x="52" y="168">The empty shelf</text><text class="part-state" x="52" y="185">searched · found nothing</text></g><g class="part"><title>A plain plate</title><g class="mark open" transform="translate(34 206)"><circle r="9"/><circle r="3" class="dot"/></g><text class="part-name" x="52" y="204">A plain plate</text><text class="part-state" x="52" y="221"></text></g><g class="part sealed"><title>The wall safe: sealed · no tool for it in the kit</title><g class="mark shut" transform="translate(34 242)"><circle r="9"/><text y="4" text-anchor="middle">#</text></g><text class="part-name" x="52" y="240">The wall safe</text><text class="part-state" x="52" y="257">sealed · no tool for it in the kit</text></g></g><g class="room unvisited" data-rel="place:vault"><title>Room vault</title><rect class="walls" x="338" y="14" width="252" height="52" rx="4"/><text class="room-name" x="352" y="36">Room vault</text><text class="part-state" x="352" y="56">not entered yet</text></g><g class="room unvisited" data-rel="place:loft"><title>Room loft</title><rect class="walls" x="662" y="14" width="252" height="52" rx="4"/><text class="room-name" x="676" y="36">Room loft</text><g class="lead-mark" transform="translate(898 30)"><title>A cat points the way.</title><circle r="8"/><text y="4" text-anchor="middle">?</text></g><text class="part-state" x="676" y="56">A cat points the way.</text></g></svg></div>
<p class="note">Click the building again, or press Esc, to put the plan away.</p>
</div>"
`;
