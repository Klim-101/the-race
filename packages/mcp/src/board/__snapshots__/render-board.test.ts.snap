// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the chronicle tab > tells each kind of turn in the player's own terms, oldest first on its day, with the hour 1`] = `
"
<h2>Chronicle</h2>
<div class="card">
<p>Now: Day 2 / 3, 09:05</p>
<p>Working time left: <strong>10 h 0 min</strong></p>
</div>
<h3>The days</h3>
<p class="note">Each bar is a turn, laid on the hours of its day, with its symbol where it ended. The night is shaded. Click a turn to light what it touched.</p>
<details class="day-strip">
<summary>Day 1</summary>
<div class="graph"><svg class="strip" viewBox="0 0 960 91" role="group" aria-label="Day 1"><rect class="night-shade" x="36" y="34" width="304" height="34"/><text class="night-label" x="188" y="28" text-anchor="middle">night</text><line class="tick" x1="36" y1="34" x2="36" y2="68"/><text class="hour" x="36" y="82" text-anchor="middle">00</text><line class="tick" x1="150" y1="34" x2="150" y2="68"/><text class="hour" x="150" y="82" text-anchor="middle">03</text><line class="tick" x1="264" y1="34" x2="264" y2="68"/><text class="hour" x="264" y="82" text-anchor="middle">06</text><line class="tick" x1="378" y1="34" x2="378" y2="68"/><text class="hour" x="378" y="82" text-anchor="middle">09</text><line class="tick" x1="492" y1="34" x2="492" y2="68"/><text class="hour" x="492" y="82" text-anchor="middle">12</text><line class="tick" x1="606" y1="34" x2="606" y2="68"/><text class="hour" x="606" y="82" text-anchor="middle">15</text><line class="tick" x1="720" y1="34" x2="720" y2="68"/><text class="hour" x="720" y="82" text-anchor="middle">18</text><line class="tick" x1="834" y1="34" x2="834" y2="68"/><text class="hour" x="834" y="82" text-anchor="middle">21</text><line class="tick" x1="948" y1="34" x2="948" y2="68"/><text class="hour" x="948" y="82" text-anchor="middle">24</text></svg></div>
<ol class="day-turns"><li data-pick="turn:1" data-rel="turn:1" tabindex="0" role="button"><span class="tag">07:50</span> Tried to get into Cellar and could not</li><li data-pick="turn:2" data-rel="turn:2" tabindex="0" role="button"><span class="tag">08:00</span> Went to Stall</li><li data-pick="turn:3" data-rel="turn:3" tabindex="0" role="button"><span class="tag">08:10</span> Looked around: found 3</li><li data-pick="turn:4" data-rel="turn:4" tabindex="0" role="button"><span class="tag">08:10</span> Studied a clue: nothing</li><li data-pick="turn:5" data-rel="turn:5" tabindex="0" role="button"><span class="tag">08:11</span> Studied a clue: something to go on</li><li data-pick="turn:6" data-rel="turn:6" tabindex="0" role="button"><span class="tag">08:12</span> Asked the locals: nothing</li><li data-pick="turn:7" data-rel="turn:7" tabindex="0" role="button"><span class="tag">08:13</span> Asked the locals: something to go on</li><li data-pick="turn:8" data-rel="turn:8" tabindex="0" role="button"><span class="tag">08:15</span> Sat down for a while: nerves back by 1</li><li data-pick="turn:9" data-rel="turn:9" tabindex="0" role="button"><span class="tag">08:20</span> Rested for the night</li><li data-pick="turn:10" data-rel="turn:10" tabindex="0" role="button"><span class="tag">11:40</span> Searched the place: found 1</li><li data-pick="turn:11" data-rel="turn:11" tabindex="0" role="button"><span class="tag">18:20</span> Questioned Anna, with pressure, showing 2 clues</li></ol>
</details>
<details class="day-strip" open>
<summary>Day 2 · today</summary>
<div class="graph"><svg class="strip" viewBox="0 0 960 91" role="group" aria-label="Day 2"><rect class="night-shade" x="36" y="34" width="304" height="34"/><text class="night-label" x="188" y="28" text-anchor="middle">night</text><line class="tick" x1="36" y1="34" x2="36" y2="68"/><text class="hour" x="36" y="82" text-anchor="middle">00</text><line class="tick" x1="150" y1="34" x2="150" y2="68"/><text class="hour" x="150" y="82" text-anchor="middle">03</text><line class="tick" x1="264" y1="34" x2="264" y2="68"/><text class="hour" x="264" y="82" text-anchor="middle">06</text><line class="tick" x1="378" y1="34" x2="378" y2="68"/><text class="hour" x="378" y="82" text-anchor="middle">09</text><line class="tick" x1="492" y1="34" x2="492" y2="68"/><text class="hour" x="492" y="82" text-anchor="middle">12</text><line class="tick" x1="606" y1="34" x2="606" y2="68"/><text class="hour" x="606" y="82" text-anchor="middle">15</text><line class="tick" x1="720" y1="34" x2="720" y2="68"/><text class="hour" x="720" y="82" text-anchor="middle">18</text><line class="tick" x1="834" y1="34" x2="834" y2="68"/><text class="hour" x="834" y="82" text-anchor="middle">21</text><line class="tick" x1="948" y1="34" x2="948" y2="68"/><text class="hour" x="948" y="82" text-anchor="middle">24</text><rect class="time-left" x="381" y="8" width="567" height="6"><title>Working time left today</title></rect><line class="now" x1="381" y1="30" x2="381" y2="72"/></svg></div>
<ol class="day-turns"><li data-pick="turn:12" data-rel="turn:12" tabindex="0" role="button"><span class="tag">09:10</span> Concluded: The baker hid the flour &lt;b&gt;.</li><li data-pick="turn:13" data-rel="turn:13" tabindex="0" role="button"><span class="tag">09:20</span> Reached a conclusion that was already drawn</li><li data-pick="turn:14" data-rel="turn:14" tabindex="0" role="button"><span class="tag">09:30</span> Linked clues that led nowhere</li><li data-pick="turn:15" data-rel="turn:15" tabindex="0" role="button"><span class="tag">09:40</span> Read again: A rusty key under the counter.</li><li data-pick="turn:16" data-rel="turn:16" tabindex="0" role="button"><span class="tag">09:50</span> Took coffee</li><li data-pick="turn:17" data-rel="turn:17" tabindex="0" role="button"><span class="tag">10:00</span> Made the accusation</li></ol>
</details>
<h3>What in the news the case grew from</h3>
<p class="empty">The case was not built on the news: today&#39;s feeds gave no seed.</p>
<h3>What has happened in the world</h3>
<p class="empty">Nothing yet. The world is holding its breath.</p>
<h3>Leads</h3>
<p class="empty">No leads yet.</p>
<h3>Still open</h3>
<ul><li data-pick="place:cellar" data-rel="place:cellar" tabindex="0" role="button">Locked: Cellar</li><li data-pick="place:chapel" data-rel="place:chapel" tabindex="0" role="button">Closed for now: Chapel</li><li data-pick="suspect:a" data-rel="suspect:a place:market" tabindex="0" role="button">Not yet questioned: Anna</li><li data-pick="suspect:b" data-rel="suspect:b place:stall" tabindex="0" role="button">Not yet questioned: Boris</li><li data-pick="suspect:c" data-rel="suspect:c" tabindex="0" role="button">Not yet questioned: Cora</li></ul>
"
`;

exports[`the clues and links tab > says on each conclusion which clues it was drawn from, with the whole text of each 1`] = `
"
<h2>Links</h2>
<p class="card"><strong>Links still to be made:</strong> Every conclusion has been drawn.</p>

<h2>Links tried</h2>
<p class="empty">No link has been tried yet.</p>
<h2>Evidence (2)</h2>
<div class="filters" role="search" aria-label="Filter the clues">
<label>Found at <select id="f-place"><option value="">any</option><option value="stall">Stall</option><option value="market">Market</option></select></label>
<label>Shown to <select id="f-suspect"><option value="">any</option></select></label>
<label><input type="checkbox" id="f-garbled"> to be read again</label>
<label><input type="checkbox" id="f-unused"> not yet used in a link</label>
<label>Number <input type="search" id="f-number" placeholder="such as MIRA-01" size="12"></label>
</div>
<div class="grid"><div class="card clue-card" id="card-key" data-pick="clue:key" data-rel="clue:key place:stall" data-place="stall" data-shown="" data-garbled="1" data-unused="1" data-number="MIRA-01" tabindex="0" role="button">
<span class="tag"><span class="num">MIRA-01</span> · found at Stall</span>
<p class="text">A rusty key under the counter.</p>
<p class="warn">read badly: read it again before it counts</p>
<p class="tag">Shown to: not shown to anyone yet</p>
<p class="tag">not used in any link</p>
<p class="tag ways"><a href="#board">On the corkboard</a> · <a href="#map">On the map</a></p>
</div>
<div class="card clue-card" id="card-flour" data-pick="clue:flour" data-rel="clue:flour place:market" data-place="market" data-shown="" data-garbled="0" data-unused="1" data-number="MIRA-02" tabindex="0" role="button">
<span class="tag"><span class="num">MIRA-02</span> · found at Market</span>
<p class="text">Flour on the cellar steps.</p>
<p class="tag">Shown to: not shown to anyone yet</p>
<p class="tag">not used in any link</p>
<p class="tag ways"><a href="#board">On the corkboard</a> · <a href="#map">On the map</a></p>
</div></div>
<p class="empty" id="clue-none" hidden>No clue fits.</p>
<h2>Conclusions (1)</h2>
<div class="card" data-rel="clue:key clue:flour"><p>The baker lied about the flour.</p>
<p class="tag">Drawn from:</p>
<span class="source"><span class="num">MIRA-01</span> A rusty key under the counter.</span>
<span class="source"><span class="num">MIRA-02</span> Flour on the cellar steps.</span></div>
"
`;

exports[`the hero tab > shows the detective, how they hold up and what they carry 1`] = `
"
<h2>Hero and kit</h2>
<div class="card">
<p><strong>Mira</strong></p>
<p class="tag">Was once: a police officer · Character: burnt out</p>
<p>Gift: Nothing left to lose: a blunder no longer frays the nerves.</p>
<p>Cost: Never fully rested, and people are harder to win over.</p>
<p>Skills: perception: 4, reasoning: 3</p>
</div>
<h3>Condition</h3>
<div class="card">
<p class="meter"><span>Reputation</span> <meter min="0" max="10" value="7">7</meter> <span class="tag">7 / 10</span></p>
<p class="meter"><span>Nerves</span> <meter min="0" max="10" value="4">4</meter> <span class="tag">4 / 10</span></p>
<p class="meter"><span>Sleep debt</span> <meter min="0" max="10" value="3">3</meter> <span class="tag">3 / 10</span></p>
<p>Now:</p>
<ul><li>exhausted <span class="tag">until the night</span></li><li>drunk <span class="tag">90 min left</span></li></ul>
<ul><li><span class="warn">reputation is low: people will not open up</span></li></ul>
</div>
<h3>Kit</h3>
<h4>In the pockets</h4>
<ul><li>phone<br><span class="tag">gets past: dark</span></li><li>lock picks <span class="warn">(lost)</span><br><span class="tag">gets past: locked</span></li><li>fingerprint powder <span class="tag">left: 2</span><br><span class="tag">gets past: a faint trace</span></li><li>test kit <span class="warn">(used up)</span><br><span class="tag">gets past: a faint trace</span></li><li>pocket knife <span class="warn">(broken)</span><br><span class="tag">gets past: soft cover</span></li><li>coffee ×2 <span class="tag">/ 2</span></li></ul>
<h4>The suitcase: 0 of 1 slots</h4>
<div class="slots">
<div class="card slot empty-card"><span class="empty">a free slot</span></div>
</div>
<h3>On its way</h3><ul><li>coffee: -1 sleep debt <span class="tag">in 30 min</span></li><li>a drink: +2 nerves <span class="tag">at night</span></li></ul>
<h3>Known traits</h3>
<ul><li>a night owl</li><li>an-unlisted-trait</li></ul>
<p class="tag">Still hidden: 2</p>

"
`;

exports[`the kit in the hero tab > lays out the pockets, the suitcase with its slots taken and free, and what each piece gets past 1`] = `
"
<h2>Hero and kit</h2>
<div class="card">
<p><strong>Mira</strong></p>
<p class="tag">Was once: a police officer</p>
<p>Skills: perception: 4, reasoning: 3</p>
</div>
<h3>Condition</h3>
<div class="card">
<p class="meter"><span>Reputation</span> <meter min="0" max="10" value="7">7</meter> <span class="tag">7 / 10</span></p>
<p class="meter"><span>Nerves</span> <meter min="0" max="10" value="8">8</meter> <span class="tag">8 / 10</span></p>
<p class="meter"><span>Sleep debt</span> <meter min="0" max="10" value="1">1</meter> <span class="tag">1 / 10</span></p>
<p>Now:</p>
<p class="empty">nothing in particular</p>

</div>
<h3>Kit</h3>
<h4>In the pockets</h4>
<ul><li>phone<br><span class="tag">gets past: dark</span></li><li>coffee ×1 <span class="tag">/ 2</span></li></ul>
<h4>The suitcase: 2 of 3 slots</h4>
<div class="slots">
<div class="card slot">crowbar <span class="warn">not within the law</span><br><span class="tag">gets past: locked, sealed</span></div>
<div class="card slot">fingerprint powder <span class="tag">left: 1</span><br><span class="tag">gets past: a faint trace</span></div>
<div class="card slot empty-card"><span class="empty">a free slot</span></div>
</div>

<h3>Known traits</h3>
<p class="empty">None revealed yet.</p>
<p class="tag">Still hidden: 2</p>

"
`;

exports[`the suspects tab > shows who they are, where they were last seen and what each has said, in order 1`] = `
"
<h2>The cast</h2>
<div class="card suspect" data-pick="suspect:a" data-rel="suspect:a place:market" tabindex="0" role="button">
<div class="who"><svg class="portrait p1" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27"/><circle class="head" cx="28" cy="21" r="9"/><path class="body" d="M10 52c1-12 8-18 18-18s17 6 18 18z"/><text x="28" y="25" text-anchor="middle">A</text></svg><div><strong>Anna</strong>
<p>Baker</p>
<p class="tag">Last seen: right here</p>
<p><span class="gauge mood-calm" role="img" aria-label="calm"><span class="step on"></span><span class="step"></span><span class="step"></span><span class="step"></span></span> <span class="tag">Mood: calm</span></p></div></div>
<h3>What they said</h3>
<div class="day"><span class="tag">day 1</span>
<p class="statement"><span class="tag">alibi</span><br>I was at the oven all night.</p></div>
<div class="day"><span class="tag">day 2</span>
<p class="statement fell"><span class="tag">gave ground · a lie that fell</span><br><s>Fine, I left at nine.</s></p>
<p class="statement"><span class="tag">let a secret out</span><br>I owe the miller money.</p></div>
<h3>Shown to them</h3>
<p class="empty">Nothing shown yet.</p>
</div>
<div class="card suspect" data-pick="suspect:c" data-rel="suspect:c" tabindex="0" role="button">
<div class="who"><svg class="portrait p3" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27"/><circle class="head" cx="28" cy="21" r="9"/><path class="body" d="M10 52c1-12 8-18 18-18s17 6 18 18z"/><text x="28" y="25" text-anchor="middle">C</text></svg><div><strong>Cora</strong>
<p>Mayor</p>
<p class="tag">Last seen: anywhere, apparently</p>
<p><span class="gauge mood-cornered" role="img" aria-label="cornered"><span class="step on"></span><span class="step on"></span><span class="step on"></span><span class="step"></span></span> <span class="tag">Mood: cornered</span></p></div></div>
<p class="warn">will not talk until day 2, 10:00</p>
<h3>What they said</h3>
<p class="empty">Nothing said yet.</p>
<h3>Shown to them</h3>
<p class="empty">Nothing shown yet.</p>
</div>
<div class="card suspect" data-pick="suspect:b" data-rel="suspect:b place:stall" tabindex="0" role="button">
<div class="who"><svg class="portrait p2" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27"/><circle class="head" cx="28" cy="21" r="9"/><path class="body" d="M10 52c1-12 8-18 18-18s17 6 18 18z"/><text x="28" y="25" text-anchor="middle">B</text></svg><div><strong>Boris</strong>
<p>Rival</p>
<p class="tag">Last seen: Stall</p>
<p><span class="gauge mood-calm" role="img" aria-label="calm"><span class="step on"></span><span class="step"></span><span class="step"></span><span class="step"></span></span> <span class="tag">Mood: calm</span></p></div></div>
<h3>What they said</h3>
<p class="empty">Nothing said yet.</p>
<h3>Shown to them</h3>
<p class="empty">Nothing shown yet.</p>
</div>
"
`;
