{
  "name": "the-race",
  "private": true,
  "description": "the RACE (Run Across a Changing Earth): a text roguelike whose world is rebuilt every day from world news.",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
