    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
