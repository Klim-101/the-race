{
  "name": "the-race",
  "private": true,
  "description": "the RACE (Run Across a Changing Earth): a text roguelike whose world is rebuilt every day from world news.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "node scripts/check-llm-denylist.mjs && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
